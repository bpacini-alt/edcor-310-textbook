// Cloudflare Worker settings.
// The Bang for Buck ratings API uses the shared D1 database through the RATINGS_DB binding.
// Serves the site folder as the website. Requests to /api/*, /editor, and /editor/*
// pass through feedback/worker.js first for APIs and private author access.
{
  "name": "science-of-learning",
  "compatibility_date": "2026-09-01",
  "previews": {
    "d1_databases": [
      {
        "binding": "RATINGS_DB",
        "database_name": "textbook-reading-ratings",
        "database_id": "596def74-d651-4f4c-a473-b7e52beaa03d"
      }
    ]
  },
  "main": "feedback/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/editor", "/editor/*"]
  },
  "d1_databases": [
    {
      "binding": "RATINGS_DB",
      "database_name": "textbook-reading-ratings",
      "database_id": "596def74-d651-4f4c-a473-b7e52beaa03d"
    }
  ]
}
