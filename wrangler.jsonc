// Cloudflare Worker settings.
// Serves the site folder as the website. Requests to /api/* go to feedback/worker.js first,
// which handles the Report a problem button (it needs the GITHUB_TOKEN secret, set in Cloudflare).
{
  "name": "science-of-learning",
  "compatibility_date": "2026-09-01",
  "main": "feedback/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
